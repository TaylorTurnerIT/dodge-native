+@contextmanager
+def verification_component(name):
+    row = getattr(VERIFY_LOCAL, 'stats', None)
+    start, cpu = time.monotonic(), time.thread_time()
+    before = None if row is None else (row['files'], row['bytes'])
+    status = 'failed'
+    try:
+        yield
+        status = 'passed'
+    finally:
+        if row is not None:
+            row['components'][name] = dict(duration_seconds=time.monotonic()-start,
+                                          thread_cpu_seconds=time.thread_time()-cpu, status=status,
+                                          observed_hash_files=row['files']-before[0],
+                                          observed_hash_bytes=row['bytes']-before[1])
+
+
+def primary_error(error, guard):
+    # A monitor failure can precede delivery to the main thread. Preserve it
+    # only when it predates the first recorded signal; user cancellation first
+    # remains cancellation. This is ordering evidence, not inferred user intent.
+    first_signal = None if life.ACTIVE is None else life.ACTIVE.first_at
+    if (guard is not None and guard.failure is not None and guard.failure_at is not None
+            and (first_signal is None or guard.failure_at <= first_signal)):
+        return guard.failure
+    return error
+
+
+def record_primary_failure(result, error):
+    """First failure owns outcome/error. Later cleanup signals are evidence only."""
+    if 'primary_failure' not in result:
+        primary = dict(outcome=failure_outcome(error), error=repr(error))
+        result.update(outcome_fields(primary['outcome']), error=primary['error'], primary_failure=primary)
+    else:
+        result.setdefault('secondary_failures', []).append(
+            dict(outcome=failure_outcome(error), error=repr(error)))
+
