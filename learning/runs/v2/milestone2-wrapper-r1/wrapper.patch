+++ b/crates/dodge-rl-env/src/config.rs
@@ -0,0 +1,71 @@
+use crate::EnvError;
+
+/// Evaluation lists are explicit, per stable slot, then episode. Exhaustion is
+/// an error; evaluation seeds are never drawn from the training stream.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum SeedMode {
+    Training { run_seed: u64 },
+    Evaluation { seeds_by_slot: Vec<Vec<u32>> },
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct EnvConfig {
+    pub batch_size: usize,
+    pub action_repeat: u8,
+    pub difficulty: u8,
+    pub patterns_enabled: bool,
+    pub powerups_enabled: bool,
+    /// Raw gameplay frames, excluding startup. Zero is invalid.
+    pub raw_frame_cap: u32,
+    pub num_threads: usize,
+    pub chunk_size: usize,
+    pub render_pixels: bool,
+    pub auxiliary_targets: bool,
+    pub seed_mode: SeedMode,
+}
+
+impl Default for EnvConfig {
+    fn default() -> Self {
+        Self {
+            batch_size: 1,
+            action_repeat: 4,
+            difficulty: 2,
+            patterns_enabled: true,
+            powerups_enabled: true,
+            raw_frame_cap: 18_000,
+            num_threads: 1,
+            chunk_size: 8,
+            render_pixels: false,
+            auxiliary_targets: false,
+            seed_mode: SeedMode::Training { run_seed: 0 },
+        }
+    }
+}
+
+impl EnvConfig {
+    pub fn validate(&self) -> Result<(), EnvError> {
+        if self.batch_size == 0 {
+            return Err(EnvError::Config("batch_size must be positive"));
+        }
+        if !(2..=4).contains(&self.action_repeat) {
+            return Err(EnvError::Config("action_repeat must be 2..=4"));
+        }
+        if !(1..=3).contains(&self.difficulty) {
+            return Err(EnvError::Config("difficulty must be 1..=3"));
+        }
+        if self.raw_frame_cap == 0 {
+            return Err(EnvError::Config("raw_frame_cap must be positive"));
+        }
+        if self.num_threads == 0 || self.chunk_size == 0 {
+            return Err(EnvError::Config("thread and chunk counts must be positive"));
+        }
+        if let SeedMode::Evaluation { seeds_by_slot } = &self.seed_mode
+            && (seeds_by_slot.len() != self.batch_size || seeds_by_slot.iter().any(Vec::is_empty))
+        {
+            return Err(EnvError::Config(
+                "evaluation needs a nonempty seed list per slot",
+            ));
+        }
+        Ok(())
+    }
+}
diff --git a/crates/dodge-rl-env/src/env.rs b/crates/dodge-rl-env/src/env.rs
new file mode 100644
--- /dev/null
+++ b/crates/dodge-rl-env/src/env.rs
@@ -0,0 +1,501 @@
+use dodge_core::{Action, BUTTON_X_MASK, FRAMEBUFFER_SIZE, Mode, NativeConfig, NativeGame};
+use rayon::prelude::*;
+
+use crate::features::{History, Observation, ObservationBatch};
+use crate::seed::{SeedMetadata, seed_for};
+use crate::{EnvConfig, EnvError, MOTION_VERSION, SEED_STREAM_VERSION};
+
+const STARTUP_LIMIT: u32 = 64;
+const PINNED_STARTUP_FRAMES: u32 = 13;
+
+#[cfg(test)]
+type RawObserver = Box<dyn FnMut(&NativeGame) + Send>;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct BatchInfo {
+    pub config: EnvConfig,
+    pub seed_stream_version: &'static str,
+    pub motion_version: &'static str,
+    pub theme_background_shadow: [u8; 2],
+    pub initial_highscores_raw_fixed: [i32; 12],
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct EpisodeInfo {
+    pub seed: SeedMetadata,
+    pub startup_frames: u32,
+    pub gameplay_frames: u32,
+    pub alive_frames: u32,
+    pub score_raw_fixed: i32,
+    pub score: f64,
+    pub score_delta_sum_raw_fixed: i64,
+    /// Computed from exact cumulative score/counts, not summed f32 rewards.
+    pub objective_return: f64,
+    pub terminated: bool,
+    pub truncated: bool,
+    pub bootstrap: bool,
+    pub diagnostics: crate::Diagnostics,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct StepBatch {
+    pub observations: ObservationBatch,
+    pub rewards: Vec<f32>,
+    pub score_delta_raw_fixed: Vec<i64>,
+    pub alive_raw_frames: Vec<u32>,
+    pub elapsed_raw_frames: Vec<u32>,
+    pub terminated: Vec<bool>,
+    pub truncated: Vec<bool>,
+    pub info: Vec<EpisodeInfo>,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct ResetBatch {
+    pub observations: ObservationBatch,
+    pub info: Vec<EpisodeInfo>,
+}
+
+struct Slot {
+    game: NativeGame,
+    seed: SeedMetadata,
+    history: History,
+    observation: Option<Observation>,
+    pixel_stack: Option<Vec<u8>>,
+    startup_frames: u32,
+    gameplay_frames: u32,
+    alive_frames: u32,
+    score_delta_sum_raw_fixed: i64,
+    terminated: bool,
+    truncated: bool,
+    #[cfg(test)]
+    raw_observer: Option<RawObserver>,
+    #[cfg(test)]
+    injected_error: Option<EnvError>,
+}
+
+#[derive(Clone, Copy)]
+struct StepCounts {
+    elapsed: u32,
+    alive: u32,
+    score: i64,
+}
+
+impl Slot {
+    fn unstarted(config: &EnvConfig, seed: SeedMetadata) -> Self {
+        let mut native = NativeConfig::new(seed.actual_seed);
+        native.difficulty = config.difficulty;
+        native.patterns_enabled = config.patterns_enabled;
+        native.powerups_enabled = config.powerups_enabled;
+        Self {
+            game: NativeGame::new(native),
+            seed,
+            history: History::default(),
+            observation: None,
+            pixel_stack: config.render_pixels.then(|| vec![0; 4 * FRAMEBUFFER_SIZE]),
+            startup_frames: 0,
+            gameplay_frames: 0,
+            alive_frames: 0,
+            score_delta_sum_raw_fixed: 0,
+            terminated: false,
+            truncated: false,
+            #[cfg(test)]
+            raw_observer: None,
+            #[cfg(test)]
+            injected_error: None,
+        }
+    }
+
+    fn start(&mut self, config: &EnvConfig) -> Result<(), EnvError> {
+        for frame in 0..STARTUP_LIMIT {
+            let result =
+                self.game
+                    .advance_frame_headless(if frame == 0 { BUTTON_X_MASK } else { 0 })?;
+            self.startup_frames += 1;
+            if result.mode == Mode::Game && !result.dead {
+                if self.startup_frames != PINNED_STARTUP_FRAMES {
+                    return Err(EnvError::Contract(
+                        "startup frame count differs from accepted pin (13)",
+                    ));
+                }
+                self.history
+                    .observe_raw(self.game.privileged_view(), self.game.enemy_serials())?;
+                self.update_observation(config, true)?;
+                return Ok(());
+            }
+            if result.dead {
+                return Err(EnvError::Contract("death during startup"));
+            }
+        }
+        Err(EnvError::Contract(
+            "bounded startup did not reach alive Game",
+        ))
+    }
+
+    fn update_observation(&mut self, config: &EnvConfig, initial: bool) -> Result<(), EnvError> {
+        let lifecycle = self.game.lifecycle();
+        let warnings = self
+            .game
+            .drawn_warning_lines()
+            .filter(|_| lifecycle.mode == Mode::Game && !lifecycle.dead);
+        let mut observation = self.history.observation(
+            self.game.privileged_view(),
+            warnings,
+            config.auxiliary_targets,
+        )?;
+        if let Some(stack) = &mut self.pixel_stack {
+            if !lifecycle.dead {
+                let mut frame = [0; FRAMEBUFFER_SIZE];
+                self.game.render_into(&mut frame);
+                if frame.iter().any(|v| *v > 15) {
+                    return Err(EnvError::Contract("palette index outside 0..15"));
+                }
+                if initial {
+                    for slot in stack.chunks_exact_mut(FRAMEBUFFER_SIZE) {
+                        slot.copy_from_slice(&frame);
+                    }
+                } else {
+                    stack.copy_within(FRAMEBUFFER_SIZE.., 0);
+                    stack[3 * FRAMEBUFFER_SIZE..].copy_from_slice(&frame);
+                }
+                observation.pixel_valid = true;
+            }
+            observation.pixels = Some(stack.clone());
+            observation.pixel_aux_pair_valid =
+                observation.pixel_valid && observation.auxiliary.is_some();
+        }
+        self.observation = Some(observation);
+        Ok(())
+    }
+
+    fn advance(&mut self, action: Action, config: &EnvConfig) -> Result<StepCounts, EnvError> {
+        let mut counts = StepCounts {
+            elapsed: 0,
+            alive: 0,
+            score: 0,
+        };
+        for _ in 0..config.action_repeat {
+            let before = self.game.score().raw();
+            let result = self.game.advance_frame_headless(action.mask())?;
+            self.gameplay_frames += 1;
+            counts.elapsed += 1;
+            // Compare native fixed values exactly. Float reward tolerances do
+            // not apply to this accounting identity, including death pickups.
+            let delta = i64::from(result.score.raw()) - i64::from(before);
+            if delta < 0 || delta != i64::from(result.score_delta.raw()) {
+                return Err(EnvError::Contract(
+                    "negative or inconsistent fixed score delta",
+                ));
+            }
+            counts.score += delta;
+            self.score_delta_sum_raw_fixed += delta;
+            if !result.dead {
+                self.alive_frames += 1;
+                counts.alive += 1;
+            }
+            self.terminated = result.dead;
+            self.truncated = !result.dead && self.gameplay_frames >= config.raw_frame_cap;
+            self.history
+                .observe_raw(self.game.privileged_view(), self.game.enemy_serials())?;
+            #[cfg(test)]
+            if let Some(observer) = &mut self.raw_observer {
+                observer(&self.game);
+            }
+            #[cfg(test)]
+            if let Some(error) = self.injected_error.take() {
+                return Err(error);
+            }
+            if result.mode != Mode::Game {
+                return Err(EnvError::Contract("gameplay left Mode::Game"));
+            }
+            if self.terminated || self.truncated {
+                break;
+            }
+        }
+        self.update_observation(config, false)?;
+        Ok(counts)
+    }
+
+    fn info(&self) -> EpisodeInfo {
+        let score_raw_fixed = self.game.score().raw();
+        let score = f64::from(score_raw_fixed) / 65536.0;
+        let cumulative = self.history.cumulative_diagnostics();
+        let mut diagnostics = self
+            .observation
+            .as_ref()
+            .map_or(crate::Diagnostics::default(), |o| o.diagnostics);
+        diagnostics.raw_history_samples = cumulative.raw_history_samples;
+        diagnostics.unknown_enemy_samples = cumulative.unknown_enemy_samples;
+        diagnostics.unknown_rectangle_samples = cumulative.unknown_rectangle_samples;
+        diagnostics.unknown_phase_samples = cumulative.unknown_phase_samples;
+        diagnostics.dropped_enemy_total = cumulative.dropped_enemy_total;
+        EpisodeInfo {
+            seed: self.seed,
+            startup_frames: self.startup_frames,
+            gameplay_frames: self.gameplay_frames,
+            alive_frames: self.alive_frames,
+            score_raw_fixed,
+            score,
+            score_delta_sum_raw_fixed: self.score_delta_sum_raw_fixed,
+            objective_return: self.score_delta_sum_raw_fixed as f64 / 65536.0
+                + f64::from(self.alive_frames) / 100.0
+                - if self.terminated { 5.0 } else { 0.0 },
+            terminated: self.terminated,
+            truncated: self.truncated,
+            bootstrap: !self.terminated,
+            diagnostics,
+        }
+    }
+}
+
+/// Persistent pool and stable simulation slots. Parallel failures retain all
+/// partially advanced games and poison the whole batch; no rollback is claimed.
+/// The initial construction performs the first fresh reset. `observations()`
+/// returns its owned initial arrays without consuming another episode seed.
+pub struct VecDodgeEnv {
+    config: EnvConfig,
+    pool: rayon::ThreadPool,
+    slots: Vec<Slot>,
+    poisoned: bool,
+    last_failures: Vec<(usize, String)>,
+}
+
+impl VecDodgeEnv {
+    pub fn new(config: EnvConfig) -> Result<Self, EnvError> {
+        config.validate()?;
+        let pool = rayon::ThreadPoolBuilder::new()
+            .num_threads(config.num_threads)
+            .build()
+            .map_err(|e| EnvError::Native(e.to_string()))?;
+        let seeds = (0..config.batch_size)
+            .map(|i| seed_for(&config.seed_mode, i, 0))
+            .collect::<Result<Vec<_>, _>>()?;
+        let mut slots = Vec::with_capacity(config.batch_size);
+        for seed in seeds {
+            let mut slot = Slot::unstarted(&config, seed);
+            slot.start(&config)?;
+            slots.push(slot);
+        }
+        Ok(Self {
+            config,
+            pool,
+            slots,
+            poisoned: false,
+            last_failures: Vec::new(),
+        })
+    }
+
+    pub fn batch_info(&self) -> BatchInfo {
+        BatchInfo {
+            config: self.config.clone(),
+            seed_stream_version: SEED_STREAM_VERSION,
+            motion_version: MOTION_VERSION,
+            theme_background_shadow: [12, 1],
+            initial_highscores_raw_fixed: [0; 12],
+        }
+    }
+    pub fn is_poisoned(&self) -> bool {
+        self.poisoned
+    }
+    pub fn last_failures(&self) -> &[(usize, String)] {
+        &self.last_failures
+    }
+    /// Available after failure for partial-state diagnostics, never neural input.
+    pub fn episode_info(&self) -> Vec<EpisodeInfo> {
+        self.slots.iter().map(Slot::info).collect()
+    }
+
+    pub fn observations(&self) -> Result<ObservationBatch, EnvError> {
+        if self.poisoned {
+            return Err(EnvError::Poisoned);
+        }
+        self.observation_subset((0..self.slots.len()).collect())
+    }
+
+    fn observation_subset(&self, indices: Vec<usize>) -> Result<ObservationBatch, EnvError> {
+        let rows = indices
+            .iter()
+            .map(|i| {
+                self.slots[*i]
+                    .observation
+                    .as_ref()
+                    .ok_or(EnvError::Contract("slot has no completed observation"))
+            })
+            .collect::<Result<Vec<_>, _>>()?;
+        Ok(ObservationBatch::collect(
+            indices,
+            rows.into_iter(),
+            self.config.render_pixels,
+            self.config.auxiliary_targets,
+        ))
+    }
+
+    pub fn step(&mut self, action_ids: &[i64]) -> Result<StepBatch, EnvError> {
+        if self.poisoned {
+            return Err(EnvError::Poisoned);
+        }
+        if action_ids.len() != self.slots.len() {
+            return Err(EnvError::ActionShape {
+                expected: self.slots.len(),
+                actual: action_ids.len(),
+            });
+        }
+        // Complete validation and copy into owned Rust storage before any slot
+        // can mutate. A later Python binding can release the GIL after this.
+        let actions = action_ids
+            .iter()
+            .enumerate()
+            .map(|(slot, &id)| {
+                usize::try_from(id)
+                    .ok()
+                    .and_then(|i| Action::ALL.get(i))
+                    .copied()
+                    .ok_or(EnvError::ActionId { slot, id })
+            })
+            .collect::<Result<Vec<_>, _>>()?;
+        for (index, slot) in self.slots.iter().enumerate() {
+            if slot.terminated || slot.truncated {
+                return Err(EnvError::SlotEnded(index));
+            }
+            if slot.game.lifecycle().mode != Mode::Game || slot.game.lifecycle().dead {
+                return Err(EnvError::Contract("step requires alive Mode::Game"));
+            }
+        }
+        let config = &self.config;
+        let results = self.pool.install(|| {
+            self.slots
+                .par_chunks_mut(config.chunk_size)
+                .enumerate()
+                .map(|(chunk, slots)| {
+                    slots
+                        .iter_mut()
+                        .enumerate()
+                        .map(|(offset, slot)| {
+                            let index = chunk * config.chunk_size + offset;
+                            (index, slot.advance(actions[index], config))
+                        })
+                        .collect::<Vec<_>>()
+                })
+                .collect::<Vec<_>>()
+        });
+        let mut counts = Vec::with_capacity(self.slots.len());
+        let mut failures = Vec::new();
+        for (index, result) in results.into_iter().flatten() {
+            match result {
+                Ok(value) => counts.push(value),
+                Err(error) => failures.push((index, error.to_string())),
+            }
+        }
+        if !failures.is_empty() {
+            return Err(self.poison(failures));
+        }
+        let info = self.episode_info();
+        Ok(StepBatch {
+            observations: self.observations()?,
+            rewards: counts
+                .iter()
+                .zip(&info)
+                .map(|(c, i)| {
+                    (c.score as f64 / 65536.0 + f64::from(c.alive) / 100.0
+                        - if i.terminated { 5.0 } else { 0.0 }) as f32
+                })
+                .collect(),
+            score_delta_raw_fixed: counts.iter().map(|c| c.score).collect(),
+            alive_raw_frames: counts.iter().map(|c| c.alive).collect(),
+            elapsed_raw_frames: counts.iter().map(|c| c.elapsed).collect(),
+            terminated: info.iter().map(|i| i.terminated).collect(),
+            truncated: info.iter().map(|i| i.truncated).collect(),
+            info,
+        })
+    }
+
+    fn poison(&mut self, failures: Vec<(usize, String)>) -> EnvError {
+        self.poisoned = true;
+        self.last_failures = failures.clone();
+        EnvError::BatchFailure(failures)
+    }
+
+    /// Only `reset_all` can recover a poisoned batch. Every requested seed is
+    /// validated first. Once mutation starts, failed fresh episodes are consumed
+    /// and retained; a later explicit reset advances their episode counters.
+    pub fn reset_done(&mut self, indices: &[usize]) -> Result<ResetBatch, EnvError> {
+        if self.poisoned {
+            return Err(EnvError::Poisoned);
+        }
+        let mut unique = std::collections::BTreeSet::new();
+        for &index in indices {
+            let slot = self.slots.get(index).ok_or(EnvError::SlotIndex(index))?;
+            if !unique.insert(index) {
+                return Err(EnvError::DuplicateReset(index));
+            }
+            if !slot.terminated && !slot.truncated {
+                return Err(EnvError::SlotNotEnded(index));
+            }
+        }
+        self.reset_indices(indices, false)
+    }
+
+    pub fn reset_all(&mut self) -> Result<ResetBatch, EnvError> {
+        let indices: Vec<_> = (0..self.slots.len()).collect();
+        self.reset_indices(&indices, true)
+    }
+
+    fn reset_indices(&mut self, indices: &[usize], all: bool) -> Result<ResetBatch, EnvError> {
+        let seeds = indices
+            .iter()
+            .map(|&index| {
+                let episode = self.slots[index]
+                    .seed
+                    .episode
+                    .checked_add(1)
+                    .ok_or(EnvError::CounterExhausted)?;
+                seed_for(&self.config.seed_mode, index, episode)
+            })
+            .collect::<Result<Vec<_>, _>>()?;
+        for (&index, seed) in indices.iter().zip(seeds) {
+            self.slots[index] = Slot::unstarted(&self.config, seed);
+            if let Err(error) = self.slots[index].start(&self.config) {
+                return Err(self.poison(vec![(index, error.to_string())]));
+            }
+        }
+        if all {
+            self.poisoned = false;
+            self.last_failures.clear();
+        }
+        Ok(ResetBatch {
+            observations: self.observation_subset(indices.to_vec())?,
+            info: indices.iter().map(|i| self.slots[*i].info()).collect(),
+        })
+    }
+}
+
+#[cfg(test)]
+impl VecDodgeEnv {
+    pub(crate) fn test_game(&self, slot: usize) -> &NativeGame {
+        &self.slots[slot].game
+    }
+    pub(crate) fn test_restore(
+        &mut self,
+        slot: usize,
+        snapshot: &dodge_core::Snapshot,
+    ) -> Result<(), EnvError> {
+        let target = &mut self.slots[slot];
+        target.game = NativeGame::restore(snapshot)?;
+        target.history = History::default();
+        target
+            .history
+            .observe_raw(target.game.privileged_view(), target.game.enemy_serials())?;
+        target.terminated = target.game.lifecycle().dead;
+        target.truncated = false;
+        target.update_observation(&self.config, true)
+    }
+    pub(crate) fn test_observer(
+        &mut self,
+        slot: usize,
+        observer: Box<dyn FnMut(&NativeGame) + Send>,
+    ) {
+        self.slots[slot].raw_observer = Some(observer);
+    }
+    pub(crate) fn test_inject_error(&mut self, slot: usize, error: EnvError) {
+        self.slots[slot].injected_error = Some(error);
+    }
+}
diff --git a/crates/dodge-rl-env/src/features.rs b/crates/dodge-rl-env/src/features.rs
new file mode 100644
--- /dev/null
+++ b/crates/dodge-rl-env/src/features.rs
@@ -0,0 +1,544 @@
+use dodge_core::{EnemySerial, EnemyState, PicoFixed, PrivilegedView, WarningLine};
+
+use crate::EnvError;
+use crate::geometry::{
+    self, PlayerBoxKind, RawAabb, RawBoxMeasures, RelativeVelocityRaw, WarningSegment,
+};
+use crate::raster::{AuxRaster, RasterChannels, RasterFlags};
+
+pub const GLOBAL_DIM: usize = 14;
+pub const ENTITY_DIM: usize = 16;
+pub const ENEMY_SLOTS: usize = 64;
+pub const RECT_SLOTS: usize = 16;
+pub const ENTITY_SLOTS: usize = ENEMY_SLOTS + RECT_SLOTS;
+pub const MOTION_VERSION: &str = "measured_center_delta_v1";
+
+/// Metadata only. None of these values is appended to neural arrays.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Diagnostics {
+    pub raw_history_samples: u64,
+    pub unknown_enemy_samples: u64,
+    pub unknown_rectangle_samples: u64,
+    pub unknown_phase_samples: u64,
+    pub admitted_enemies: usize,
+    pub admitted_rectangles: usize,
+    pub onscreen_warnings: usize,
+    pub dropped_enemies: usize,
+    pub dropped_enemy_total: u64,
+    pub inverted_boxes: u64,
+    pub inverted_axes: u64,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Observation {
+    pub global_feats: [[f32; GLOBAL_DIM]; 1],
+    pub entity_feats: [[f32; ENTITY_DIM]; ENTITY_SLOTS],
+    pub entity_types: [i64; ENTITY_SLOTS],
+    pub entity_mask: [bool; ENTITY_SLOTS],
+    /// Oldest to newest, contiguous [4,128,128].
+    pub pixels: Option<Vec<u8>>,
+    pub auxiliary: Option<Box<RasterChannels>>,
+    pub pixel_valid: bool,
+    /// False if either member is absent, or pixels precede terminal state.
+    pub pixel_aux_pair_valid: bool,
+    pub diagnostics: Diagnostics,
+}
+
+/// Contiguous row-major arrays, owned by this return value. `indices` defines
+/// the row-to-stable-slot mapping, including caller-ordered partial resets.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ObservationBatch {
+    pub indices: Vec<usize>,
+    pub global_feats: Vec<f32>,
+    pub entity_feats: Vec<f32>,
+    pub entity_types: Vec<i64>,
+    pub entity_mask: Vec<bool>,
+    pub pixels: Option<Vec<u8>>,
+    pub auxiliary: Option<Vec<f32>>,
+    pub pixel_valid: Vec<bool>,
+    pub pixel_aux_pair_valid: Vec<bool>,
+    pub diagnostics: Vec<Diagnostics>,
+}
+
+impl ObservationBatch {
+    pub(crate) fn collect<'a>(
+        indices: Vec<usize>,
+        rows: impl Iterator<Item = &'a Observation>,
+        pixels: bool,
+        auxiliary: bool,
+    ) -> Self {
+        let mut batch = Self {
+            indices,
+            global_feats: Vec::new(),
+            entity_feats: Vec::new(),
+            entity_types: Vec::new(),
+            entity_mask: Vec::new(),
+            pixels: pixels.then(Vec::new),
+            auxiliary: auxiliary.then(Vec::new),
+            pixel_valid: Vec::new(),
+            pixel_aux_pair_valid: Vec::new(),
+            diagnostics: Vec::new(),
+        };
+        for row in rows {
+            batch.global_feats.extend_from_slice(&row.global_feats[0]);
+            batch
+                .entity_feats
+                .extend(row.entity_feats.iter().flatten().copied());
+            batch.entity_types.extend_from_slice(&row.entity_types);
+            batch.entity_mask.extend_from_slice(&row.entity_mask);
+            if let (Some(out), Some(input)) = (&mut batch.pixels, &row.pixels) {
+                out.extend_from_slice(input);
+            }
+            if let (Some(out), Some(input)) = (&mut batch.auxiliary, &row.auxiliary) {
+                out.extend(input.iter().flatten().flatten().copied());
+            }
+            batch.pixel_valid.push(row.pixel_valid);
+            batch.pixel_aux_pair_valid.push(row.pixel_aux_pair_valid);
+            batch.diagnostics.push(row.diagnostics);
+        }
+        batch
+    }
+
+    pub fn batch_size(&self) -> usize {
+        self.indices.len()
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+struct Motion {
+    /// Raw Q16.16 units; halves remain representable in f64.
+    dx: f64,
+    dy: f64,
+    dhx: f64,
+    dhy: f64,
+}
+
+impl Motion {
+    fn measured(now: RawBoxMeasures, old: RawBoxMeasures) -> Self {
+        Self {
+            dx: (now.center_x_twice_raw - old.center_x_twice_raw) as f64 / 2.0,
+            dy: (now.center_y_twice_raw - old.center_y_twice_raw) as f64 / 2.0,
+            dhx: (now.half_x_twice_raw - old.half_x_twice_raw) as f64 / 2.0,
+            dhy: (now.half_y_twice_raw - old.half_y_twice_raw) as f64 / 2.0,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+struct MeasuredEntity {
+    bounds: RawAabb,
+    motion: Motion,
+    type_id: i64,
+    admitted: bool,
+    lethal_now: bool,
+    charging: bool,
+    until_lethal: f64,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct EnemyHistory {
+    serial: EnemySerial,
+    measures: RawBoxMeasures,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct RectHistory {
+    measures: RawBoxMeasures,
+    sh: PicoFixed,
+}
+
+/// Only selected geometry and observed charge are retained. A None-pattern raw
+/// frame clears rectangle history even if another activation appears within K.
+#[derive(Default)]
+pub(crate) struct History {
+    enemies: Vec<EnemyHistory>,
+    rectangles: Vec<RectHistory>,
+    current_enemies: Vec<(EnemySerial, MeasuredEntity)>,
+    current_rectangles: Vec<MeasuredEntity>,
+    pattern_present: bool,
+    diagnostics: Diagnostics,
+}
+
+fn enemy_geometry(enemy: &EnemyState) -> Result<(RawAabb, bool, i64), EnvError> {
+    let x = enemy.x.raw();
+    let y = enemy.y.raw();
+    let s = enemy.size.raw();
+    let type_id = match enemy.personality {
+        0 => 1,
+        1 => 2,
+        -1 => 3,
+        2 => 4,
+        3 => 5,
+        4 => 6,
+        _ => return Err(EnvError::Contract("unsupported enemy personality")),
+    };
+    let beneficial = (4..=6).contains(&type_id);
+    let (bounds, footprint) = if beneficial {
+        (
+            geometry::powerup_box(x, y),
+            geometry::powerup_footprint(x, y),
+        )
+    } else {
+        (
+            geometry::enemy_box(x, y, s),
+            geometry::enemy_footprint(x, y, s),
+        )
+    };
+    Ok((bounds, footprint.intersects_world(), type_id))
+}
+
+impl History {
+    pub(crate) fn cumulative_diagnostics(&self) -> Diagnostics {
+        self.diagnostics
+    }
+
+    pub(crate) fn observe_raw(
+        &mut self,
+        view: PrivilegedView<'_>,
+        serials: Option<&[EnemySerial]>,
+    ) -> Result<(), EnvError> {
+        let serials = serials.ok_or(EnvError::Contract("enemy identity metadata unavailable"))?;
+        if serials.len() != view.enemies.len() || !serials.windows(2).all(|w| w[0] < w[1]) {
+            return Err(EnvError::Contract("enemy identity length/order mismatch"));
+        }
+        self.diagnostics.raw_history_samples =
+            self.diagnostics.raw_history_samples.saturating_add(1);
+        let mut old_index = 0;
+        let mut next = Vec::with_capacity(serials.len());
+        self.current_enemies.clear();
+        for (&serial, enemy) in serials.iter().zip(view.enemies) {
+            while self
+                .enemies
+                .get(old_index)
+                .is_some_and(|old| old.serial < serial)
+            {
+                old_index += 1;
+            }
+            let (bounds, admitted, type_id) = enemy_geometry(enemy)?;
+            let measures = bounds.measures();
+            let motion = if let Some(old) = self
+                .enemies
+                .get(old_index)
+                .filter(|old| old.serial == serial)
+            {
+                Motion::measured(measures, old.measures)
+            } else {
+                self.diagnostics.unknown_enemy_samples =
+                    self.diagnostics.unknown_enemy_samples.saturating_add(1);
+                Motion::default()
+            };
+            let beneficial = (4..=6).contains(&type_id);
+            next.push(EnemyHistory { serial, measures });
+            self.current_enemies.push((
+                serial,
+                MeasuredEntity {
+                    bounds,
+                    motion,
+                    type_id,
+                    admitted,
+                    lethal_now: !beneficial,
+                    charging: false,
+                    until_lethal: if beneficial { 1.0 } else { 0.0 },
+                },
+            ));
+        }
+        self.enemies = next;
+        self.current_rectangles.clear();
+        if let Some(pattern) = view.active_pattern {
+            if pattern.pattern_type > 1 {
+                return Err(EnvError::Contract("unsupported pattern type"));
+            }
+            let mut next = Vec::with_capacity(pattern.rects.len());
+            for (index, rect) in pattern.rects.iter().enumerate() {
+                let bounds = geometry::rectangle_box(
+                    rect.x.raw(),
+                    rect.y.raw(),
+                    rect.width.raw(),
+                    rect.height.raw(),
+                );
+                let measures = bounds.measures();
+                let old = self
+                    .pattern_present
+                    .then(|| self.rectangles.get(index))
+                    .flatten();
+                let motion = old.map_or_else(
+                    || {
+                        self.diagnostics.unknown_rectangle_samples =
+                            self.diagnostics.unknown_rectangle_samples.saturating_add(1);
+                        Motion::default()
+                    },
+                    |old| Motion::measured(measures, old.measures),
+                );
+                let sh_delta = old.map(|old| i64::from(rect.sh.raw()) - i64::from(old.sh.raw()));
+                let lethal_now = pattern.pattern_type == 1 || rect.sh == PicoFixed::from_int(2);
+                let charging = !lethal_now
+                    && rect.sh < PicoFixed::from_int(2)
+                    && sh_delta.is_some_and(|d| d > 0);
+                let until_lethal = if lethal_now {
+                    0.0
+                } else if charging {
+                    ((f64::from(PicoFixed::from_int(2).raw()) - f64::from(rect.sh.raw()))
+                        / sh_delta.unwrap_or(1) as f64)
+                        .clamp(0.0, 120.0)
+                        / 120.0
+                } else {
+                    1.0
+                };
+                if pattern.pattern_type == 0 && !lethal_now && sh_delta.is_none() {
+                    self.diagnostics.unknown_phase_samples =
+                        self.diagnostics.unknown_phase_samples.saturating_add(1);
+                }
+                self.current_rectangles.push(MeasuredEntity {
+                    bounds,
+                    motion,
+                    type_id: if pattern.pattern_type == 0 { 7 } else { 8 },
+                    admitted: geometry::rectangle_footprint(
+                        rect.x.raw(),
+                        rect.y.raw(),
+                        rect.width.raw(),
+                        rect.height.raw(),
+                    )
+                    .intersects_world(),
+                    lethal_now,
+                    charging,
+                    until_lethal,
+                });
+                next.push(RectHistory {
+                    measures,
+                    sh: rect.sh,
+                });
+            }
+            self.rectangles = next;
+            self.pattern_present = true;
+        } else {
+            self.rectangles.clear();
+            self.pattern_present = false;
+        }
+        Ok(())
+    }
+
+    pub(crate) fn observation<'a>(
+        &mut self,
+        view: PrivilegedView<'_>,
+        warnings: impl Iterator<Item = &'a WarningLine>,
+        auxiliary: bool,
+    ) -> Result<Observation, EnvError> {
+        let rects: Vec<_> = self
+            .current_rectangles
+            .iter()
+            .filter(|e| e.admitted)
+            .copied()
+            .collect();
+        if rects.len() > RECT_SLOTS {
+            return Err(EnvError::RectangleOverflow(rects.len()));
+        }
+        let mut raster = AuxRaster::default();
+        let mut onscreen_warnings = 0;
+        for warning in warnings {
+            let segment = WarningSegment::from_raw_q16(
+                warning.x0.raw(),
+                warning.y0.raw(),
+                warning.x1.raw(),
+                warning.y1.raw(),
+            )
+            .map_err(|_| EnvError::Contract("non-axis-aligned drawn warning"))?;
+            if segment.intersects_world() {
+                onscreen_warnings += 1;
+                if auxiliary {
+                    raster.paint_warning(
+                        segment,
+                        RasterFlags {
+                            lethal_soon: true,
+                            ..RasterFlags::default()
+                        },
+                    );
+                }
+            }
+        }
+        let mut enemies: Vec<_> = self
+            .current_enemies
+            .iter()
+            .filter(|(_, e)| e.admitted)
+            .map(|(serial, e)| {
+                (
+                    *serial,
+                    *e,
+                    entity_features(*e, view),
+                    slab_frames(*e, view),
+                )
+            })
+            .collect();
+        let admitted_enemies = enemies.len();
+        // Auxiliary targets include all admitted geometry, even a token dropped
+        // by enemy overflow. The target is the current visible scene occupancy.
+        for e in enemies.iter().map(|(_, e, _, _)| e).chain(rects.iter()) {
+            let flags = RasterFlags {
+                lethal_now: e.lethal_now,
+                lethal_soon: e.charging,
+                enemy: (1..=3).contains(&e.type_id),
+                powerup: (4..=6).contains(&e.type_id),
+                player: false,
+            };
+            // Paint even when targets are disabled to retain inverted diagnostics.
+            raster.paint_box(e.bounds, flags);
+        }
+        if auxiliary {
+            raster.paint_box(
+                geometry::player_box(
+                    view.player.x.raw(),
+                    view.player.y.raw(),
+                    view.player.size.raw(),
+                    PlayerBoxKind::Powerup,
+                ),
+                RasterFlags {
+                    player: true,
+                    ..RasterFlags::default()
+                },
+            );
+        }
+        let dropped = admitted_enemies.saturating_sub(ENEMY_SLOTS);
+        if dropped > 0 {
+            enemies.sort_by(|a, b| a.3.total_cmp(&b.3).then(a.0.cmp(&b.0)));
+            enemies.truncate(ENEMY_SLOTS);
+        }
+        self.diagnostics.dropped_enemy_total = self
+            .diagnostics
+            .dropped_enemy_total
+            .saturating_add(dropped as u64);
+        let raster_diagnostics = raster.diagnostics();
+        let diagnostics = Diagnostics {
+            admitted_enemies,
+            admitted_rectangles: rects.len(),
+            onscreen_warnings,
+            dropped_enemies: dropped,
+            inverted_boxes: raster_diagnostics.inverted_boxes,
+            inverted_axes: raster_diagnostics.inverted_axes,
+            ..self.diagnostics
+        };
+        let mut out = Observation {
+            global_feats: [global_features(
+                view,
+                !rects.is_empty() || onscreen_warnings > 0,
+            )],
+            entity_feats: [[0.0; ENTITY_DIM]; ENTITY_SLOTS],
+            entity_types: [0; ENTITY_SLOTS],
+            entity_mask: [false; ENTITY_SLOTS],
+            pixels: None,
+            auxiliary: auxiliary.then(|| Box::new(raster.into_channels())),
+            pixel_valid: false,
+            pixel_aux_pair_valid: false,
+            diagnostics,
+        };
+        for (i, (_, e, features, _)) in enemies.into_iter().enumerate() {
+            out.entity_feats[i] = features;
+            out.entity_types[i] = e.type_id;
+            out.entity_mask[i] = true;
+        }
+        for (i, e) in rects.into_iter().enumerate() {
+            let i = ENEMY_SLOTS + i;
+            out.entity_feats[i] = entity_features(e, view);
+            out.entity_types[i] = e.type_id;
+            out.entity_mask[i] = true;
+        }
+        if !out
+            .global_feats
+            .iter()
+            .flatten()
+            .chain(out.entity_feats.iter().flatten())
+            .all(|v| v.is_finite())
+        {
+            return Err(EnvError::Contract("nonfinite neural feature"));
+        }
+        Ok(out)
+    }
+}
+
+fn global_features(view: PrivilegedView<'_>, pattern_visible: bool) -> [f32; GLOBAL_DIM] {
+    let p = view.player;
+    let x = p.x.to_double();
+    let y = p.y.to_double();
+    [
+        ((x - 64.0) / 64.0) as f32,
+        ((y - 64.0) / 64.0) as f32,
+        (p.vx.to_double() / 2.5) as f32,
+        (p.vy.to_double() / 2.5) as f32,
+        (p.size.to_double() / 4.0) as f32,
+        view.freeze_rate.to_f32(),
+        (view.speed.to_double() / 3.0) as f32,
+        (view.enemy_est.to_double() / 2.0) as f32,
+        (view.score.to_double() / 50.0).tanh() as f32,
+        f32::from(pattern_visible),
+        ((x - 2.0) / 123.0) as f32,
+        ((125.0 - x) / 123.0) as f32,
+        ((y - 2.0) / 123.0) as f32,
+        ((125.0 - y) / 123.0) as f32,
+    ]
+}
+
+fn entity_features(e: MeasuredEntity, view: PrivilegedView<'_>) -> [f32; ENTITY_DIM] {
+    let measures = e.bounds.measures();
+    let cx = geometry::half_raw_to_pixels(measures.center_x_twice_raw);
+    let cy = geometry::half_raw_to_pixels(measures.center_y_twice_raw);
+    let kind = match e.type_id {
+        4..=6 => PlayerBoxKind::Powerup,
+        7..=8 => PlayerBoxKind::Rectangle,
+        _ => PlayerBoxKind::EnemyFamily,
+    };
+    let player = geometry::player_box(
+        view.player.x.raw(),
+        view.player.y.raw(),
+        view.player.size.raw(),
+        kind,
+    );
+    let (gx, gy) = e.bounds.signed_gaps(player);
+    let contact = geometry::slab_contact(
+        e.bounds,
+        player,
+        RelativeVelocityRaw {
+            x: e.motion.dx - f64::from(view.player.vx.raw()),
+            y: e.motion.dy - f64::from(view.player.vy.raw()),
+        },
+    );
+    let velocity_scale = f64::from(geometry::ONE_RAW) * 4.0;
+    [
+        ((cx - 64.0) / 128.0) as f32,
+        ((cy - 64.0) / 128.0) as f32,
+        (geometry::half_raw_to_pixels(measures.half_x_twice_raw) / 64.0) as f32,
+        (geometry::half_raw_to_pixels(measures.half_y_twice_raw) / 64.0) as f32,
+        ((cx - view.player.x.to_double()) / 128.0) as f32,
+        ((cy - view.player.y.to_double()) / 128.0) as f32,
+        (e.motion.dx / velocity_scale) as f32,
+        (e.motion.dy / velocity_scale) as f32,
+        (e.motion.dhx / velocity_scale) as f32,
+        (e.motion.dhy / velocity_scale) as f32,
+        (geometry::raw_to_pixels(gx) / 64.0) as f32,
+        (geometry::raw_to_pixels(gy) / 64.0) as f32,
+        (contact.frames / 120.0) as f32,
+        e.until_lethal as f32,
+        f32::from((4..=6).contains(&e.type_id)),
+        f32::from(e.lethal_now),
+    ]
+}
+
+fn slab_frames(e: MeasuredEntity, view: PrivilegedView<'_>) -> f64 {
+    let kind = match e.type_id {
+        4..=6 => PlayerBoxKind::Powerup,
+        7..=8 => PlayerBoxKind::Rectangle,
+        _ => PlayerBoxKind::EnemyFamily,
+    };
+    let player = geometry::player_box(
+        view.player.x.raw(),
+        view.player.y.raw(),
+        view.player.size.raw(),
+        kind,
+    );
+    geometry::slab_contact(
+        e.bounds,
+        player,
+        RelativeVelocityRaw {
+            x: e.motion.dx - f64::from(view.player.vx.raw()),
+            y: e.motion.dy - f64::from(view.player.vy.raw()),
+        },
+    )
+    .frames
+}
diff --git a/crates/dodge-rl-env/src/lib.rs b/crates/dodge-rl-env/src/lib.rs
new file mode 100644
--- /dev/null
+++ b/crates/dodge-rl-env/src/lib.rs
@@ -0,0 +1,54 @@
+//! Pure Rust, owned-batch Dodge environment. No Python or window dependency.
+mod config;
+mod env;
+mod features;
+pub mod geometry;
+pub mod raster;
+mod seed;
+
+pub use config::{EnvConfig, SeedMode};
+pub use env::{BatchInfo, EpisodeInfo, ResetBatch, StepBatch, VecDodgeEnv};
+pub use features::{
+    Diagnostics, ENEMY_SLOTS, ENTITY_DIM, ENTITY_SLOTS, GLOBAL_DIM, MOTION_VERSION, Observation,
+    ObservationBatch, RECT_SLOTS,
+};
+pub use seed::{SEED_STREAM_VERSION, SeedMetadata, training_seed};
+
+/// A failed call never implies rollback. A batch failure requires `reset_all`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum EnvError {
+    Config(&'static str),
+    ActionShape { expected: usize, actual: usize },
+    ActionId { slot: usize, id: i64 },
+    SlotIndex(usize),
+    DuplicateReset(usize),
+    SlotNotEnded(usize),
+    SlotEnded(usize),
+    Poisoned,
+    SeedExhausted { slot: usize, episode: u64 },
+    CounterExhausted,
+    Native(String),
+    Contract(&'static str),
+    RectangleOverflow(usize),
+    BatchFailure(Vec<(usize, String)>),
+}
+
+impl std::fmt::Display for EnvError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "{self:?}")
+    }
+}
+
+impl std::error::Error for EnvError {}
+
+impl From<dodge_core::CoreError> for EnvError {
+    fn from(value: dodge_core::CoreError) -> Self {
+        Self::Native(value.to_string())
+    }
+}
+
+#[cfg(test)]
+mod tests;
