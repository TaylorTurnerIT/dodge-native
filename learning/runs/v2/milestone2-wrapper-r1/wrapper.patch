+        } else {
+            enemy_footprint(q(x).raw(), q(y).raw(), q(size).raw())
+        };
+        let mut differences = 0;
+        for (i, (&a, &b)) in base.iter().zip(&pixels).enumerate() {
+            if a != b {
+                differences += 1;
