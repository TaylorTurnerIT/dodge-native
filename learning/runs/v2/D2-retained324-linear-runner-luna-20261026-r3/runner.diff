+def initialize_or_restore_schedule(optimizer, actual_cumulative_updates,
+                                   saved_schedule=None, scheduled_resume=False):
+    """Initialize only at the original parent, or validate an explicit scheduled resume."""
+    if saved_schedule is None:
+        need(not scheduled_resume, "Scheduled resume requires saved schedule metadata")
+        need(type(actual_cumulative_updates) is int
+             and actual_cumulative_updates == SCHEDULE_ORIGIN_CUMULATIVE_UPDATE,
+             "Fresh schedule requires inherited cumulative update 372")
+        return lr_schedule.new_schedule_state(optimizer, actual_cumulative_updates)
+    need(scheduled_resume, "Saved schedule metadata requires scheduled-resume mode")
+    return validate_future_scheduled_resume(saved_schedule, actual_cumulative_updates, optimizer)
+
+
+def validate_future_scheduled_resume(saved_schedule, actual_cumulative_updates, optimizer):
+    """Pure future-resume gate; never infer schedule state from a counter."""
+    need(saved_schedule is not None, "Scheduled resume requires saved schedule metadata")
+    need(type(actual_cumulative_updates) is int
+         and actual_cumulative_updates >= SCHEDULE_ORIGIN_CUMULATIVE_UPDATE,
+         "Scheduled resume cumulative update is invalid")
+    state = lr_schedule.validate_schedule_state(saved_schedule, optimizer)
+    need(state["completed_schedule_updates"]
+         == actual_cumulative_updates - SCHEDULE_ORIGIN_CUMULATIVE_UPDATE,
+         "Saved schedule counter disagrees with actual cumulative update")
+    validate_saved_schedule_lr({"optimizer": optimizer.state_dict(), "lr_schedule": state},
+                               actual_cumulative_updates)
+    return state
+
+
+def stage_schedule_update(optimizer, schedule_state, inherited_cumulative_updates,
+                          local_cumulative_updates, actual_cumulative_updates):
+    """Set next optimizer LR and stage metadata from inherited plus local counters."""
+    need(type(inherited_cumulative_updates) is int
+         and inherited_cumulative_updates == SCHEDULE_ORIGIN_CUMULATIVE_UPDATE,
+         "Inherited cumulative updates must equal 372")
+    need(type(local_cumulative_updates) is int and local_cumulative_updates >= 0,
+         "Local cumulative updates must be a nonnegative integer")
+    need(type(actual_cumulative_updates) is int
+         and actual_cumulative_updates == inherited_cumulative_updates + local_cumulative_updates,
+         "Actual cumulative update differs from inherited plus local")
+    lr, staged = lr_schedule.apply_next_update_lr(
+        optimizer, schedule_state, actual_cumulative_updates)
+    return lr, staged
+
+
+def validate_saved_schedule_lr(state, actual_cumulative_updates):
+    """Bind saved optimizer group LRs to schedule progress at the saved counter."""
+    need(type(actual_cumulative_updates) is int
+         and actual_cumulative_updates >= SCHEDULE_ORIGIN_CUMULATIVE_UPDATE,
+         "Saved cumulative update is invalid")
+    schedule = lr_schedule.validate_schedule_state(state["lr_schedule"],
+                                                   _OptimizerView(state["optimizer"]["param_groups"]))
+    need(schedule["completed_schedule_updates"]
+         == actual_cumulative_updates - SCHEDULE_ORIGIN_CUMULATIVE_UPDATE,
+         "Saved schedule counter disagrees with actual cumulative update")
+    expected = (SCHEDULE_START_LR if actual_cumulative_updates == SCHEDULE_ORIGIN_CUMULATIVE_UPDATE
+                else lr_schedule.learning_rate_for_cumulative_update(actual_cumulative_updates))
+    assert_saved_optimizer_lr(state, expected)
+    return expected
+
+
+def commit_schedule_after_success(schedule_state, staged_schedule, actual_cumulative_updates,
+                                  inherited_cumulative_updates, local_cumulative_updates,
+                                  checks_passed):
+    """Commit only after PPO output and all diagnostics pass validation."""
+    need(checks_passed is True, "Cannot commit schedule before all PPO checks pass")
+    need(type(inherited_cumulative_updates) is int
+         and inherited_cumulative_updates == SCHEDULE_ORIGIN_CUMULATIVE_UPDATE
+         and type(local_cumulative_updates) is int and local_cumulative_updates >= 0,
+         "Schedule commit requires inherited 372 and nonnegative local progress")
+    need(type(actual_cumulative_updates) is int
+         and actual_cumulative_updates == inherited_cumulative_updates + local_cumulative_updates,
+         "Schedule commit counters disagree")
+    current = lr_schedule.validate_schedule_state(schedule_state, _OptimizerView([{"lr": 0.0}] * schedule_state["optimizer_param_group_count"]))
+    staged = lr_schedule.validate_schedule_state(staged_schedule, _OptimizerView([{"lr": 0.0}] * staged_schedule["optimizer_param_group_count"]))
+    need(current["completed_schedule_updates"] == local_cumulative_updates
+         and staged["completed_schedule_updates"] == local_cumulative_updates + 1,
+         "Staged schedule progress differs from successful update")
+    return dict(staged)
+
