+"""Actual CPython scheduling and exact r12 source-delta checks.
+
+Signals are modeled by calling the unchanged ProcessLatch.handle directly.
+No OS signal delivery, timer installation, lifecycle/stress or ML run occurs.
+Reader threads use real stdlib threading and real interval operations.
+"""
+from pathlib import Path
+from contextlib import contextmanager
+from unittest.mock import patch
+import ast
+import hashlib
+import json
+import math
+import os
+import signal
+import sys
+import tempfile
+import threading
+import time
+import unittest
+import lifecycle as life
+import long_d2 as c
+import long_d2_executor as e
+
+H = Path(__file__).resolve().parent
+BASE = H / 'r11-source'
+A = Path(os.environ['VALIDATION_DIR'])
+SCHEDULING_HELPERS = {'restore_boundary_switch_interval', 'boundary_switch_interval'}
+
+
+def controller_without_r12_delta(text):
+    """Exact byte projection; no AST normalization of protected source bodies."""
+    lines = text.splitlines(True)
+    for node in sorted((n for n in ast.parse(text).body
+                        if isinstance(n, ast.FunctionDef) and n.name in SCHEDULING_HELPERS),
+                       key=lambda n: n.lineno, reverse=True):
+        first = min([node.lineno] + [n.lineno for n in node.decorator_list])
+        # Each added helper owns its following two blank lines.
+        del lines[first - 1:node.end_lineno + 2]
+    value = ''.join(lines)
+    value = value.replace('BOUNDARY_SWITCH_INTERVAL = 0.0001\n', '')
+    value = value.replace('postovernight-long-D2-boundary-prepare-r12',
+                          'postovernight-long-D2-boundary-prepare-r11')
+    value = value.replace('postovernight-long-D2-r2-protocol-r9.json',
+                          'postovernight-long-D2-r2-protocol-r8.json')
+    value = value.replace(c.PROTOCOL_SHA256,
+                          'fe11c08159bdb9ca1f03cb0fb96ffd133ad144d107b2a854d19fc49159aa2db2')
+    wrapped = '                with boundary_switch_interval():\n                    observation = self.verify()\n'
+    if value.count(wrapped) != 1:
+        raise AssertionError('Exactly one wrapped callback required')
+    return value.replace(wrapped, '                observation = self.verify()\n')
+
+
+class OtherBaseException(BaseException):
+    pass
+
+
+class R12(unittest.TestCase):
+    def setUp(self):
+        self.d = Path(tempfile.mkdtemp(prefix=self._testMethodName + '-', dir=A))
+        self.original = sys.getswitchinterval()
+        self.addCleanup(self.restore_test_interval)
+
+    def restore_test_interval(self):
+        # Independent fixture cleanup: midpoint of the observed microsecond bin.
+        # Test intervals are small positive integer microseconds, never huge floats.
+        ticks = round(self.original / 1e-6)
+        sys.setswitchinterval((ticks + .5) / 1e6)
+        self.assertEqual(sys.getswitchinterval(), self.original)
+
+    def save(self, name, value):
+        with (self.d / (name + '.json')).open('x') as stream:
+            json.dump(value, stream, indent=2, sort_keys=True, allow_nan=False)
+            stream.write('\n')
+
+    def guard(self, callback):
+        return c.Guard(time.monotonic() + 10, lambda: None, callback, None,
+                       rss=lambda: 1, peak=lambda: 1)
+
+    def test_01_success_scoped_and_outside_unchanged(self):
+        sys.setswitchinterval(.005)
+        before = sys.getswitchinterval()
+        with c.boundary_switch_interval():
+            inside = sys.getswitchinterval()
+            self.assertGreater(inside, 0)
+            self.assertLessEqual(inside, c.BOUNDARY_SWITCH_INTERVAL)
+        self.assertEqual(sys.getswitchinterval(), before)
+        self.save('success', dict(before=before, inside=inside, after=sys.getswitchinterval()))
