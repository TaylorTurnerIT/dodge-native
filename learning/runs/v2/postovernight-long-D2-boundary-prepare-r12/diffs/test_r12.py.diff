+        proposed = json.loads((H / 'protocol-r9-proposal.json').read_text())
+        declaration = proposed.pop('boundary_scheduling')
+        proposed['registered_at_utc'] = old['registered_at_utc']
+        normalized = json.loads(json.dumps(proposed).replace(
+            'postovernight-long-D2-boundary-prepare-r12/', 'postovernight-long-D2-boundary-prepare-r11/'))
+        self.assertEqual(normalized, old)
+        self.assertEqual(declaration['interval_seconds'], .0001)
+        self.assertIs(declaration['process_global'], True)
+        self.assertEqual(hashlib.sha256((H / 'protocol-r9-proposal.json').read_bytes()).hexdigest(), c.PROTOCOL_SHA256)
+        self.assertTrue(c.PREPARE_REL.endswith('prepare-r12'))
+        self.assertTrue(c.PROTOCOL_REL.endswith('protocol-r9.json'))
+        self.assertFalse((c.ORIGINAL_ROOT / c.PROTOCOL_REL).exists(), 'Parent owns external publication')
+        self.assertFalse(any((H / name).exists() for name in
+            ('classification.json', 'long-identity.json', 'registration.json', 'capsule-final', 'required-lease.json')))
