+        paths += [c.ORIGINAL_ROOT / name for name in protocol['base_identity']['sources'] if name.endswith('.py')]
+        for path in paths:
+            self.assertNotIn('setswitchinterval', path.read_text(), str(path))
+        source = (H / 'long_d2.py').read_text()
+        tree = ast.parse(source)
+        guard = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == 'Guard')
+        start = next(n for n in guard.body if isinstance(n, ast.FunctionDef) and n.name == 'start')
+        monitor = next(n for n in start.body if isinstance(n, ast.FunctionDef) and n.name == 'monitor')
+        self.assertIn('self.sample(full=False)', ast.get_source_segment(source, monitor))
+        self.assertNotIn('full_check', ast.get_source_segment(source, monitor))
+        self.save('ownership', dict(enforced='main-thread scheduling helper entry',
+            registered_source_setters=0, scanned_paths=[str(p) for p in paths],
+            assumption='No cooperating or external concurrent setter during callback; arbitrary third-party/native setters are not proven absent.',
+            per_Guard_lock_is_not_process_global=True))
