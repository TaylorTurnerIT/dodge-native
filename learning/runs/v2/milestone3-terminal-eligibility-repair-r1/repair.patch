+def validate_terminal_receipt(run_dir: Path, anchor: dict) -> tuple[dict, dict]:
+    """Check immutable terminal evidence against authority supplied by the parent.
+
+    The artifact index proves consistency only. Raw source-lease document hashes
+    belong to the anchor; copied identity/config documents are compared
+    semantically because the runner serializes them again.
+    """
+    run_dir = Path(run_dir)
+    fields = {"run_id", "phase", "run_result_sha256", "checkpoint_sha256",
+              "evaluation_sha256", "identity_sha256", "config_sha256", "supervisor_exit_code"}
+    require(isinstance(anchor, dict) and set(anchor) == fields, "Invalid parent terminal receipt anchor")
+    require(type(anchor["supervisor_exit_code"]) is int and anchor["supervisor_exit_code"] == 0,
+            "Parent did not observe successful supervisor exit")
+    require(isinstance(anchor["run_id"], str) and bool(anchor["run_id"]), "Invalid source run ID")
+    for field in fields - {"run_id", "phase", "supervisor_exit_code"}:
+        value = anchor[field]
+        require(isinstance(value, str) and len(value) == 64
+                and all(char in "0123456789abcdef" for char in value), "Invalid terminal anchor hash")
+    require(anchor["phase"] in set(read_protocol()["seed_namespace_table"]) - {"probe"},
+            "Source phase is not a registered training phase")
+    result_path = run_dir / "run-result.json"
+    require(file_hash(result_path) == anchor["run_result_sha256"], "Terminal run-result hash differs")
+    rr = json.loads(result_path.read_bytes())
+    require(rr["status"] == "passed" and type(rr["worker_exit_code"]) is int
+            and rr["worker_exit_code"] == 0, "Source run did not finish successfully")
+    for field in ("run_id", "phase", "identity_sha256", "config_sha256"):
+        require(rr[field] == anchor[field], f"Terminal source {field} differs")
+    require(type(rr["automatic_retries"]) is int and rr["automatic_retries"] == 0
+            and rr["limits_relaxed"] is False and rr["B_opened"] is False
+            and rr.get("E_opened", False) is False, "Source run relaxed limits/retried/opened B/E")
+    from .identity import validate_config
+    config = validate_config(json.loads((run_dir / "registered-config.json").read_bytes()))
+    identity = json.loads((run_dir / "identity.json").read_bytes())
+    require(config["phase"] == anchor["phase"] and identity["config"] == config
+            and identity["config_sha256"] == identity_hash(config), "Terminal source identity/config differs")
+    consumed = rr["consumed_phase_wall_seconds"]
+    require(type(consumed) in (int, float) and math.isfinite(consumed)
+            and 0 <= consumed <= config["phase_settings"]["budget_seconds"],
+            "Source phase wall budget was not completed within registered limit")
+    wr = json.loads((run_dir / "worker-result.json").read_bytes())
+    require(wr == rr["worker_result"] and wr["status"] == "passed", "Terminal worker result differs or failed")
+    for field in ("phase", "identity_sha256", "config_sha256"):
+        require(wr[field] == anchor[field], f"Terminal worker {field} differs")
+    require(wr.get("B_opened", False) is False and wr.get("E_opened", False) is False,
+            "Source worker opened B/E")
+    name = wr["checkpoint"]
+    require(isinstance(name, str) and name not in {"", ".", ".."} and Path(name).name == name,
+            "Terminal checkpoint must be an exact local filename")
+    checkpoint_path = run_dir / name
+    require(wr["checkpoint_sha256"] == anchor["checkpoint_sha256"] == file_hash(checkpoint_path),
+            "Terminal checkpoint hash differs")
+    proof_path = evaluation_path(checkpoint_path)
+    proof = json.loads(proof_path.read_bytes())
+    require(file_hash(proof_path) == anchor["evaluation_sha256"] and proof == wr["evaluation"]
+            and proof["checkpoint_sha256"] == anchor["checkpoint_sha256"]
+            and proof["phase"] == anchor["phase"]
+            and proof["complete"] is True and proof["passed"] is True,
+            "Terminal evaluation differs or is not complete/passing/hash-bound")
+    require(not (set(proof["evaluations"]) - {"D1", "D2", "D3"}), "Terminal evaluation opened B/E")
