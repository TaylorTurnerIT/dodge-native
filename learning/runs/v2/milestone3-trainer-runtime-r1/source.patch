+            hashes = {str(p.relative_to(args.run_dir)): file_hash(p) for p in sorted(args.run_dir.rglob("*")) if p.is_file()}
+            save_json(args.run_dir / "artifact-sha256.json", hashes)
+    return 0 if result["status"] == "passed" else 1
