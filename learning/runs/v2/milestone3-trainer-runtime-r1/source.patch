+               "--run-dir", str(args.run_dir.resolve()), "--identity-sha256", identity_digest,
+               "--config-sha256", config_digest, "--deadline-monotonic", str(deadline),
+               "--consumed-wall-seconds", str(consumed), "--execution-started-monotonic", str(started)]
