+        raise ProcessLookupError("already exited")
+    process.wait=lambda timeout:0
+    monkeypatch.setattr(s.os,"killpg",signal)
+    result=s.stop_owned(process)
+    assert result["reaped"] and result["exit_signal_race"] and result["errors"]==[]
