      "distinct_across_replicas": true
    },
    "torch_cpu_global_seed": {
      "owner": "process-wide torch CPU default generator",
      "role": "minibatch shuffle and any CPU-side torch draw",
      "consumed_by": [
        "torch.randperm(16384, device='cpu') once per epoch",
