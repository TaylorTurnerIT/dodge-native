    "constructor_init_seed": {
      "owner": "python learner bootstrap (train_teacher.seed_initialization)",
      "role": "seeds Python/NumPy/torch-CPU before model construction",
      "consumed_by": [
        "nn.init.orthogonal_ actor/critic heads",
