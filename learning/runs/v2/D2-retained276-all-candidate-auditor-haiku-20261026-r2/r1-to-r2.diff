+class R2RebindingControls(unittest.TestCase):
+    """R2 differs from frozen R1 only by RUN_ID and progress=progress; real parent rows pass the validator."""
+
+    def parent_rows(self):
+        """Accepted parent metric rows, relabelled to the 276->348 phase window (local counters unchanged)."""
+        rows, _ = a.parse_journal(a.read_stable(a.PARENT_RUN / "training-metrics.jsonl"), strict=True)
+        return [copy.deepcopy({**row, "phase_update": a.PHASE_START + row["local_update"]}) for row in rows]
+
+    def test_runner_delta_from_frozen_r1_is_run_id_and_progress_only(self):
+        r1 = (a.ROOT / "learning/runs/v2/D2-retained276-continuation-prepare-luna-20261026-r1/runner.py").read_bytes()
+        self.assertEqual(a.sha_bytes(r1), "3ed39368b8118e36d84b1554aeea815a3e2bf6ea52c597a07f3ae2c1b4fb1e71")
+        old, new = r1.decode("utf-8").splitlines(), a.read_stable(a.PREP / "runner.py").decode("utf-8").splitlines()
+        self.assertEqual(len(old), len(new))
+        changed = [i for i, (x, y) in enumerate(zip(old, new)) if x != y]
+        self.assertEqual(len(changed), 2)
+        self.assertEqual(old[changed[0]], 'RUN_ID = "D2-retained276-continuation-20261026-r1"')
+        self.assertEqual(new[changed[0]], 'RUN_ID = "D2-retained276-continuation-20261026-r2"')
+        self.assertEqual(old[changed[1]].strip(), "gradient_alignment_diagnostics=True)")
+        self.assertEqual(new[changed[1]].strip(), "gradient_alignment_diagnostics=True, progress=progress)")
+
+    def test_ppo_update_call_receives_progress(self):
+        tree = ast.parse(a.read_stable(a.PREP / "runner.py"))
+        calls = [n for n in ast.walk(tree) if isinstance(n, ast.Call) and getattr(n.func, "id", None) == "ppo_update"]
+        self.assertEqual(len(calls), 1)
+        self.assertIn("progress", {kw.arg for kw in calls[0].keywords})
