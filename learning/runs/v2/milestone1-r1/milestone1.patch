+        let pattern = full
+            .patterns
+            .get(index)
+            .ok_or(CoreError::InvalidSnapshotValue)?;
+        saw_static |= pattern.pattern_type == 0;
+        saw_moving |= pattern.pattern_type == 1;
+        let mut headless = full.clone();
