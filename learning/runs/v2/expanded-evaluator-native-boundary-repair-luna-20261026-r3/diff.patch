 class ExpandedEvalTests(unittest.TestCase):
+    def test_native_excluded_ranges_use_strict_tuple_boundary(self):
+        protocol = b'{"training_excluded_ranges":[[1,2],[5,8]]}'
+        converted = expanded_eval._native_excluded_seed_ranges(protocol)
+
+        def strict_native_boundary(ranges):
+            if type(ranges) is not list or any(type(pair) is not tuple for pair in ranges):
+                raise TypeError("excluded_seed_ranges requires list[tuple[int, int]]")
+
+        with self.assertRaisesRegex(TypeError, "requires list\\[tuple"):
+            strict_native_boundary(json.loads(protocol)["training_excluded_ranges"])
+        strict_native_boundary(converted)
+        self.assertEqual(converted, [(1, 2), (5, 8)])
+
