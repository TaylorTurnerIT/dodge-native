+    /// End selected alive episodes after their exact H-reaching K=4 step.
+    ///
+    /// Validate the entire request before mutation. Horizons are positive 1000
+    /// multiples below both 18000 and the configured ordinary cap.
+    /// True deaths and ordinary cap endings must be excluded by the caller;
+    /// explicitly supplying either rejects the whole request. No frame, reward,
+    /// native state, observation/history, diagnostic or seed counter advances.
+    /// Returned owned snapshots follow request order and match `episode_info`.
+    /// The caller synchronizes its retained step masks/info before bootstrap,
+    /// storage and one normal subset reset. No observation payload is needed.
+    pub fn truncate_practice(
+        &mut self,
+        indices: &[usize],
+        horizons: &[u32],
+    ) -> Result<Vec<EpisodeInfo>, EnvError> {
+        if self.poisoned {
+            return Err(EnvError::Poisoned);
+        }
+        if indices.len() != horizons.len() {
+            return Err(EnvError::PracticeShape {
+                indices: indices.len(),
+                horizons: horizons.len(),
+            });
+        }
+        if self.config.action_repeat != 4 {
+            return Err(EnvError::Config("practice cutoff requires action_repeat=4"));
+        }
+        let mut unique = std::collections::BTreeSet::new();
+        for (&index, &horizon) in indices.iter().zip(horizons) {
+            let slot = self.slots.get(index).ok_or(EnvError::SlotIndex(index))?;
+            if !unique.insert(index) {
+                return Err(EnvError::DuplicatePractice(index));
+            }
+            if slot.terminated || slot.truncated {
+                return Err(EnvError::SlotEnded(index));
+            }
+            if slot.game.lifecycle().mode != Mode::Game || slot.game.lifecycle().dead {
+                return Err(EnvError::Contract(
+                    "practice cutoff requires alive Mode::Game",
+                ));
+            }
+            if horizon == 0
+                || horizon % 1000 != 0
+                || horizon >= 18_000
+                || horizon >= self.config.raw_frame_cap
+            {
+                return Err(EnvError::PracticeHorizon {
+                    slot: index,
+                    horizon,
+                });
+            }
+            if horizon % 4 != 0 || slot.gameplay_frames % 4 != 0 || slot.gameplay_frames != horizon
+            {
+                return Err(EnvError::PracticeFrame {
+                    slot: index,
+                    expected: horizon,
+                    actual: slot.gameplay_frames,
+                });
+            }
+            // Preserve the existing checked episode-counter invariant without
+            // consuming a seed or changing the counter. Reset retains its own
+            // complete seed-availability validation before mutation.
+            slot.seed
+                .episode
+                .checked_add(1)
+                .ok_or(EnvError::CounterExhausted)?;
+        }
+        for &index in indices {
+            self.slots[index].truncated = true;
+        }
+        Ok(indices
+            .iter()
+            .map(|&index| self.slots[index].info())
+            .collect())
+    }
+
     /// Only `reset_all` can recover a poisoned batch. Every requested seed is
     /// validated first. Once mutation starts, failed fresh episodes are consumed
     /// and retained; a later explicit reset advances their episode counters.
