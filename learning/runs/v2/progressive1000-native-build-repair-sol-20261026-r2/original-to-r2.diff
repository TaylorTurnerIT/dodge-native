+    /// Mark exact aligned practice boundaries and return owned episode info.
+    /// The caller retains the existing step's final observations and rewards.
+    fn truncate_practice<'py>(
+        &mut self,
+        py: Python<'py>,
+        indices: &Bound<'py, PyAny>,
+        horizons: &Bound<'py, PyAny>,
+    ) -> PyResult<Bound<'py, PyList>> {
+        let indices = integer_input(indices)?
+            .into_iter()
+            .map(|i| {
+                usize::try_from(i).map_err(|_| {
+                    PyValueError::new_err("practice index must be nonnegative and fit usize")
+                })
+            })
+            .collect::<PyResult<Vec<_>>>()?;
+        let horizons = integer_input(horizons)?
+            .into_iter()
