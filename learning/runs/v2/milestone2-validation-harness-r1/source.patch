+    prefixes = {"V2_FULL_PARITY_EPISODE ": "episode", "V2_FULL_PARITY_PATTERN ": "pattern", "V2_FULL_PARITY_DIFFICULTY ": "difficulty", "V2_FULL_PARITY_TOTAL ": "total"}
