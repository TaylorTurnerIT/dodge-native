+def restore_boundary_switch_interval(previous):
+    """Restore the observed CPython value, including microsecond quantization.
+
+    getswitchinterval() can return 99.99999999999999 microseconds for an
+    internal 100-microsecond value. Setting that float can truncate to 99.
+    The adjacent larger float corrects that truncation; equality is mandatory.
+    This is a bounded correction, not a retry of a failed verification.
+    """
+    if sys.getswitchinterval() != previous:
+        sys.setswitchinterval(previous)
+        if sys.getswitchinterval() != previous:
+            sys.setswitchinterval(math.nextafter(previous, math.inf))
+        require(sys.getswitchinterval() == previous, 'Boundary switch interval restoration failed')
+
+
+@contextmanager
+def boundary_switch_interval():
+    """Temporarily cap the process-global interval during forced byte work.
+
+    Registered boundaries run on the main thread; resource observers use
+    full=False. Enforce that single-thread ownership across Guard instances.
+    Cooperating code must not set the interval concurrently: verify_lock is
+    per Guard and cannot serialize arbitrary process-global setters. Already
+    shorter intervals remain shorter. No signal/timer ownership is changed.
+
+    The outer finally recovers one exception interrupting inner restoration.
+    Arbitrary repeated asynchronous interruptions cannot be guaranteed safe;
+    a leak can change guard outcomes as well as performance.
+    """
+    require(threading.current_thread() is threading.main_thread(),
+            'Boundary switch interval requires main-thread ownership')
+    previous = sys.getswitchinterval()
+    try:
+        try:
+            if previous > BOUNDARY_SWITCH_INTERVAL:
+                sys.setswitchinterval(BOUNDARY_SWITCH_INTERVAL)
+            yield
+        finally:
+            restore_boundary_switch_interval(previous)
+    finally:
+        restore_boundary_switch_interval(previous)
+
+
 class Guard:
